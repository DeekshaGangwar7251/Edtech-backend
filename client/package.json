{
  "name": "react-tailwind-css-starter-pack",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ramonak/react-progress-bar": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.16.1",
    "chart.js": "^4.4.4",
    "concurrently": "^9.2.1",
    "input-otp": "^1.4.2",
    "react-chartjs-2": "^5.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^20.1.0",
    "react-hook-form": "^7.76.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-otp-input": "^3.1.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "react-scripts": "5.0.1",
    "react-stars": "^2.2.5",
    "react-type-animation": "^3.2.0",
    "redux": "^5.0.1",
    "video-react": "^0.16.0",
    "web-vitals": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepranaygupta/react-tailwind-css-starter-pack.git"
  },
  "author": "Pranay Gupta",
  "bugs": {
    "url": "https://github.com/thepranaygupta/react-tailwind-css-starter-pack/issues"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true BROWSERSLIST_ENV=production react-scripts build",
    "eject": "react-scripts eject",
    "server": "cd server && npm run dev",
    "dev": "concurrently -n \"client,server\" -c \"bgBlue,bgYellow\" \"npm start\" \"npm run server\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
 
  "browserslist": {
  "production": [
    "> 0.2%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not op_mini all"
  ],
  "development": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ]
  
},
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tailwindcss": "^3.2.7"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}

